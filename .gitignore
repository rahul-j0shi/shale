# In-repo toolchain (vendored JDK, Gradle distribution + caches). Installed by
# scripts/bootstrap.sh; never committed — large, platform-specific, reproducible.
.tools/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
gradle-app.setting

# Java
*.class
*.log
hs_err_pid*
replay_pid*

# jqwik failure-sample database (per-module test artifact)
.jqwik-database

# Engine artifacts / test scratch (never commit data files or WAL/SSTable output)
*.wal
*.sst
*.db
MANIFEST-*
CURRENT
data/
/tmp-test/

# Exception: golden fixtures are committed on purpose (on-disk-formats.md §4). The blanket
# rules above would otherwise silently drop them, and a golden that is not in the repo cannot
# catch a format change on a clean clone.
!shale-core/src/test/resources/golden/**

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
*.swp

# OS
.DS_Store
Thumbs.db
